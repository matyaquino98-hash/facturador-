# Puerto del backend
PORT=3000

# Base SQLite
DB_FILE=data/facturador.sqlite

# Clave maestra para cifrar los certificados y claves privadas de ARCA.
# OBLIGATORIA en producción. Generala con: openssl rand -base64 48
# Si la perdés, las credenciales guardadas quedan ilegibles y hay que volver a cargarlas.
APP_ENCRYPTION_KEY=

# true detrás de HTTPS (marca la cookie de sesión como Secure)
COOKIE_SECURE=false

NODE_ENV=development
